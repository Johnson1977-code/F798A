/* ST7789V Display */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/display/panel.h>

/ {
    chosen {
        zephyr,display = &st7789v_lcd;
    };

    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi00>;
        dc-gpios = <&gpio2 6 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio2 7 GPIO_ACTIVE_LOW>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";

        st7789v_lcd: st7789v@0 {
            compatible = "sitronix,st7789v";
            reg = <0>;
            status = "okay";

            /* ---- 尺寸 ---- */
            width = <280>;
            height = <240>;
            x-offset = <0>;
            y-offset = <0>;

            /* ---- MIPI DBI 传输参数（binding required!）---- */
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";              /* SPI 4-wire */
            mipi-max-frequency = <32000000>;

            /* ---- 电源/控制寄存器（binding required）---- */
            vcom = <0x20>;
            gctrl = <0x35>;
            vrhs = <0x12>;
            vdvs = <0x20>;
            mdac = <0x00>;
            lcm = <0x0c>;
            colmod = <0x55>;
            gamma = <0x01>;

            /* ---- 字节数组（binding required）---- */
            porch-param = [0c 0c 00 33 33];
            cmd2en-param = [5a 69 02 01];
            pwctrl1-param = [a4 a1];
            pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
            nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
            ram-param = [00 f0];
            rgb-param = [cd 08 14];
        };
    };
};

&spi00 {
    status = "okay";
    cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
};
